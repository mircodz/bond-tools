<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>BondTools.Models</PackageId>
    <Title>Bond Generated Model Support</Title>
    <RootNamespace>BondTools.Models</RootNamespace>
    <Authors>Mirco De Zorzi</Authors>
    <Description>Support for generated Bond C# descriptors, cloning, equality, and debugger views. This package does not provide serialization.</Description>
    <PackageTags>bond;codegen;models;metadata</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
  </PropertyGroup>
  <ItemGroup>
    <None Update="README.md" Pack="true" PackagePath="/" />
    <None Include="../LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
