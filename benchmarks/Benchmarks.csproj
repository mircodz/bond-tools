<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <PackageReference Include="Bond.Runtime.CSharp" />
    <PackageReference Include="Newtonsoft.Json" />
    <ProjectReference Include="../Bond.Runtime/Bond.Runtime.csproj" />
    <ProjectReference Include="../Bond.Parser.CLI/Bond.Parser.CLI.csproj" ReferenceOutputAssembly="false" />
    <BondSchema Include="schemas/*.bond" />
    <!-- shop.bond has bases, which C# structs can't have. -->
    <BondStructSchema Include="schemas/collections.bond;schemas/order.bond" />
  </ItemGroup>

  <Target Name="GenerateBondModels" BeforeTargets="CoreCompile">
    <MSBuild Projects="../Bond.Parser.CLI/Bond.Parser.CLI.csproj" Targets="GetTargetPath">
      <Output TaskParameter="TargetOutputs" PropertyName="BondCli" />
    </MSBuild>
    <PropertyGroup>
      <BondGenerated>$(IntermediateOutputPath)bond/</BondGenerated>
    </PropertyGroup>
    <Exec Command="dotnet &quot;$(BondCli)&quot; generate csharp @(BondSchema->'&quot;%(FullPath)&quot;', ' ') -o &quot;$(BondGenerated)&quot; --serialization --clear" StandardOutputImportance="low" />
    <Exec Command="dotnet &quot;$(BondCli)&quot; generate csharp @(BondStructSchema->'&quot;%(FullPath)&quot;', ' ') -o &quot;$(BondGenerated)structs/&quot; --serialization --clear --structs --namespace Bench=Bench.Structs" StandardOutputImportance="low" />
    <ItemGroup>
      <Compile Include="$(BondGenerated)*.g.cs;$(BondGenerated)structs/*.g.cs" />
    </ItemGroup>
  </Target>
</Project>
