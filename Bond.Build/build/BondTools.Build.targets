<Project>
  <ItemDefinitionGroup>
    <Bond>
      <ImportDirectories>$(BondImportDirectories)</ImportDirectories>
      <Usings>$(BondUsings)</Usings>
      <NamespaceMappings>$(BondNamespaceMappings)</NamespaceMappings>
      <TypeMappings>$(BondTypeMappings)</TypeMappings>
      <Clone>$(BondClone)</Clone>
      <Equality>$(BondEquality)</Equality>
      <ToString>$(BondToString)</ToString>
      <Clear>$(BondClear)</Clear>
      <Serialization>$(BondSerialization)</Serialization>
    </Bond>
  </ItemDefinitionGroup>

  <ItemGroup>
    <UpToDateCheckInput Include="@(Bond)" />
  </ItemGroup>

  <UsingTask TaskName="BondTools.Build.GenerateBond" AssemblyFile="$(MSBuildThisFileDirectory)../tasks/net8.0/Bond.Build.dll" />

  <!-- Runs before the compiler's input cache is computed, so removed schemas also trigger recompilation. -->
  <Target Name="BondGenerateCSharp" BeforeTargets="BeforeCompile;CoreCompile;CompileDesignTime"
          Condition="'$(IsCrossTargetingBuild)' != 'true'">
    <PropertyGroup>
      <_BondOutputDirectory>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'bond'))</_BondOutputDirectory>
    </PropertyGroup>

    <Error Condition="'@(Bond)' != '' and '$(MSBuildRuntimeType)' != 'Core'" Code="BOND1000"
           Text="BondTools.Build requires .NET SDK MSBuild (dotnet build)." />

    <GenerateBond Condition="'@(Bond)' != '' or Exists('$(_BondOutputDirectory)')"
                  Sources="@(Bond)" ProjectDirectory="$(MSBuildProjectDirectory)" OutputDirectory="$(_BondOutputDirectory)">
      <Output TaskParameter="GeneratedFiles" ItemName="Compile" />
      <Output TaskParameter="GeneratedFiles" ItemName="FileWrites" />
    </GenerateBond>
  </Target>
</Project>
