<Project>
  <PropertyGroup>
    <!-- Import candidates can appear without changing any existing input. -->
    <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <Bond>
      <Descriptors>$(BondDescriptors)</Descriptors>
      <Clone>$(BondClone)</Clone>
      <Equality>$(BondEquality)</Equality>
      <Debugger>$(BondDebugger)</Debugger>
    </Bond>
  </ItemDefinitionGroup>

  <UsingTask TaskName="BondTools.Build.GenerateBond"
             AssemblyFile="$(MSBuildThisFileDirectory)../tasks/netstandard2.0/BondTools.Build.dll" />

  <Target Name="BondGenerateCSharp" BeforeTargets="BeforeCompile;CoreCompile;CompileDesignTime"
          Condition="'$(IsCrossTargetingBuild)' != 'true'">
    <PropertyGroup>
      <_BondOutputDirectory>$([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'bond'))</_BondOutputDirectory>
    </PropertyGroup>
    <GenerateBond Condition="'@(Bond)' != '' or Exists('$(_BondOutputDirectory)/manifest.json')"
                  ProjectFile="$(MSBuildProjectFullPath)"
                  OutputDirectory="$(_BondOutputDirectory)"
                  CompilerPath="$(MSBuildThisFileDirectory)../tools/net8.0/any/Bond.Parser.CLI.dll"
                  DotNetHostPath="$(DotNetHostPath)"
                  Sources="@(Bond)"
                  ImportDirectories="@(BondImportDirectory)"
                  Usings="@(BondUsing)"
                  NamespaceMappings="@(BondNamespaceMapping)"
                  TypeMappings="@(BondTypeMapping)">
      <Output TaskParameter="GeneratedFiles" ItemName="_BondGeneratedFiles" />
      <Output TaskParameter="WrittenFiles" ItemName="FileWrites" />
    </GenerateBond>
    <ItemGroup>
      <Compile Remove="@(_BondGeneratedFiles)" />
      <Compile Include="@(_BondGeneratedFiles)" AutoGen="true" DesignTime="true" Visible="false" />
    </ItemGroup>
  </Target>
</Project>
