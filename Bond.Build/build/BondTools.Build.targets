<Project>
  <PropertyGroup>
    <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <Bond>
      <Descriptors>$(BondDescriptors)</Descriptors>
      <Clone>$(BondClone)</Clone>
      <Equality>$(BondEquality)</Equality>
      <Debugger>$(BondDebugger)</Debugger>
      <ToString>$(BondToString)</ToString>
    </Bond>
  </ItemDefinitionGroup>

  <UsingTask TaskName="BondTools.Build.GenerateBond"
             AssemblyFile="$(MSBuildThisFileDirectory)../tasks/net8.0/Bond.Build.dll"
             Condition="'$(MSBuildRuntimeType)' == 'Core'" />

  <Target Name="BondGenerateCSharp" BeforeTargets="BeforeCompile;CoreCompile;CompileDesignTime"
          Condition="'$(IsCrossTargetingBuild)' != 'true'">
    <PropertyGroup>
      <_BondOutputDirectory>$([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'bond'))</_BondOutputDirectory>
      <_BondUnsupportedSdk Condition="'$(NETCoreSdkVersion)' != ''">$([MSBuild]::VersionLessThan('$(NETCoreSdkVersion)', '8.0'))</_BondUnsupportedSdk>
    </PropertyGroup>

    <Error Condition="('@(Bond)' != '' or Exists('$(_BondOutputDirectory)/manifest.json')) and ('$(MSBuildRuntimeType)' != 'Core' or '$(_BondUnsupportedSdk)' == 'true')"
           Code="BOND1001"
           Text="BondTools.Build requires .NET 8 or newer SDK MSBuild. Use 'dotnet build' with a .NET 8+ SDK instead of legacy Full MSBuild." />

    <GenerateBond Condition="'$(MSBuildRuntimeType)' == 'Core' and ('@(Bond)' != '' or Exists('$(_BondOutputDirectory)/manifest.json'))"
                  ProjectFile="$(MSBuildProjectFullPath)"
                  OutputDirectory="$(_BondOutputDirectory)"
                  Sources="@(Bond)"
                  ImportDirectories="@(BondImportDirectory)"
                  Usings="@(BondUsing)"
                  NamespaceMappings="@(BondNamespaceMapping)"
                  TypeMappings="@(BondTypeMapping)">
      <Output TaskParameter="GeneratedFiles" ItemName="_BondGeneratedFiles" />
      <Output TaskParameter="WrittenFiles" ItemName="FileWrites" />
    </GenerateBond>

    <ItemGroup>
      <Compile Remove="@(_BondGeneratedFiles)" />
      <Compile Include="@(_BondGeneratedFiles)" AutoGen="true" DesignTime="true" Visible="false" />
    </ItemGroup>
  </Target>
</Project>
