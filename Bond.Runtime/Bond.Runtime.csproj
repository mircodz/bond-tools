<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AssemblyName>BondTools.Runtime</AssemblyName>
    <RootNamespace>BondTools.Runtime</RootNamespace>
    <PackageId>BondTools.Runtime</PackageId>
    <Authors>Mirco De Zorzi</Authors>
    <Description>Reflection-free Bond Compact Binary serialization for code generated by bond-tools.</Description>
    <PackageTags>bond;serialization;compact-binary</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <IsAotCompatible>true</IsAotCompatible>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- Generated models use its attributes and its IBonded<T> for bonded<T> fields. -->
    <PackageReference Include="Bond.Core.CSharp" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="../LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
